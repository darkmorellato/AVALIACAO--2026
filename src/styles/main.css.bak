/**
 * @file styles/main.css
 * @description Estilos principais do dashboard Avaliacao 2026.
 * Organizado em secoes: base, layout, components, theme, print.
 * Suporte a dark mode via variaveis CSS e nesting nativo.
 *
 * @author Kilo Assistant
 * @date 2026-05-20
 */

/* ==========================================================================
   BASE
   ========================================================================== */

@layer base {
  :root {
    /* Color primitive tokens */
    --color-slate-50: #f8fafc;
    --color-slate-100: #f1f5f9;
    --color-slate-200: #e2e8f0;
    --color-slate-300: #cbd5e1;
    --color-slate-400: #94a3b8;
    --color-slate-500: #64748b;
    --color-slate-600: #475569;
    --color-slate-700: #334155;
    --color-slate-800: #1e293b;
    --color-slate-900: #0f172a;

    --color-indigo-500: #6366f1;
    --color-indigo-600: #4f46e5;
    --color-blue-500: #3b82f6;

    --color-red-500: #ef4444;
    --color-amber-500: #f59e0b;
    --color-emerald-500: #10b981;

    /* Semantic tokens - Light mode (default) */
    --main-bg: #f8fafc;
    --card-bg: #ffffff;
    --card-raw: #ffffff;
    --text: var(--color-slate-900);
    --text-secondary: var(--color-slate-500);
    --border: rgba(226, 232, 240, 0.6); /* border-slate-200/60 */
    --progress: var(--color-slate-100);
    --shadow-color: rgba(6, 81, 237, 0.05);
    --shadow-lg-color: rgba(0, 0, 0, 0.08);

    /* Shadows */
    --shadow: 0 4px 20px -4px var(--shadow-color);
    --shadow-lg: 0 8px 30px var(--shadow-lg-color);

    /* Accent */
    --gradient: linear-gradient(135deg, var(--color-indigo-500), var(--color-blue-500));
    --glass: 1px solid #f1f5f9; /* border-slate-100 */
    --active: var(--color-blue-500);

    /* Status colors */
    --low: var(--color-red-500);
    --med: var(--color-amber-500);
    --good: var(--color-blue-500);
    --great: var(--color-emerald-500);

    /* Layout */
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --radius-3xl: 24px;
    --radius-full: 9999px;

    /* Typography */
    --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Dark mode overrides */
  :root.dark,
  .dark {
    --main-bg: var(--color-slate-900);
    --card-bg: #1e293b;
    --card-raw: #1e293b;
    --text: #f8fafc;
    --text-secondary: var(--color-slate-400);
    --border: var(--color-slate-700);
    --progress: var(--color-slate-700);
    --shadow-color: rgba(0, 0, 0, 0.3);
    --shadow-lg-color: rgba(0, 0, 0, 0.4);
    --glass: 1px solid rgba(255, 255, 255, 0.05);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--main-bg);
    color: var(--text);
    margin: 0;
    padding: 0;
    display: flex;
    min-height: 100vh;
    transition: background 0.5s cubic-bezier(0.4, 0, 0.2, 1), color 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body.dark,
  body:has(.dark) {
    background-color: var(--color-slate-900);
  }

  /* Loading state */
  body.is-loading {
    cursor: wait;
  }
}

/* ==========================================================================
   ANIMATIONS
   ========================================================================== */

@layer animations {
  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    0% { opacity: 0.7; }
    100% { opacity: 1; }
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

@keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }

    @keyframes cardEnter {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  /* Staggered card animations - triggers when body has .loaded */
  body.loaded .card-metrics > .metric-card,
  body.loaded section.card > .card,
  body.loaded .detailed-data-card {
    opacity: 0;
    animation: cardEnter 0.6s ease-out forwards;
  }
  body.loaded .card-metrics > .metric-card:nth-child(1), body.loaded .card:nth-child(1) { animation-delay: 0.1s; }
  body.loaded .card-metrics > .metric-card:nth-child(2), body.loaded .card:nth-child(2) { animation-delay: 0.2s; }
body.loaded .card-metrics > .metric-card:nth-child(3), body.loaded .card:nth-child(3) { animation-delay: 0.3s; }
  body.loaded .card-metrics > .metric-card:nth-child(4), body.loaded .card:nth-child(4) { animation-delay: 0.4s; }
  body.loaded .card:nth-child(5) { animation-delay: 0.5s; }
  body.loaded .card:nth-child(6) { animation-delay: 0.6s; }
}

/* ==========================================================================
   LAYOUT
   ========================================================================== */

@layer layout {
  .dashboard-layout {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  .main-content {
    flex-grow: 1;
    padding: 24px;
    width: 100%;
    box-sizing: border-box;

    @media (max-width: 1200px) {
      padding: 20px;
    }

    @media (max-width: 768px) {
      padding: 12px;
    }
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 32px;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }
  }
}

/* ==========================================================================
   COMPONENTS
   ========================================================================== */

@layer components {
  /* Buttons */
  .btn {
    padding: 10px 20px;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .btn-export {
    background: var(--gradient);
    color: #fff;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);

    &:hover {
      transform: translateY(-2px);
    }
  }

  .btn-toggle {
    background: var(--card-bg);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 14px;
    border-radius: 16px; /* rounded-2xl */
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.5s ease;
    box-shadow: 0 2px 10px -3px rgba(6, 81, 237, 0.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;

    &:hover {
      color: var(--active);
      transform: scale(1.05);
    }

    & i {
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .dark & i {
      transform: rotate(180deg);
    }
  }

  .btn-retry {
    background: var(--gradient);
    color: #fff;
    margin-top: 16px;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
    }
  }

  /* PREMIUM HEADER */
  .dashboard-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 32px;
  }
  @media (min-width: 768px) {
    .dashboard-header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    & h1 {
      font-size: 1.875rem; /* text-3xl */
      font-weight: 800;
      color: var(--text);
      margin: 0;
      letter-spacing: -0.025em;
    }
    @media (min-width: 768px) {
      & h1 {
        font-size: 2.25rem; /* text-4xl */
      }
    }

    & .subtitle {
      color: var(--text-secondary);
      margin: 8px 0 0 0;
      font-weight: 500;
      font-size: 1rem;
    }
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    
    @media (min-width: 768px) {
      width: auto;
    }
  }

  /* Status badge with ping animation */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 9999px;
    background: rgba(59, 130, 246, 0.05); /* bg-blue-50/5% */
    border: 1px solid rgba(59, 130, 246, 0.1);
    color: var(--color-blue-500);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }
  .dark .status-badge {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.2);
  }

  .ping-container {
    position: relative;
    display: flex;
    height: 8px;
    width: 8px;
  }
  .ping-animate {
    animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    position: absolute;
    display: inline-flex;
    height: 100%;
    width: 100%;
    border-radius: 9999px;
    background-color: var(--color-blue-500);
    opacity: 0.75;
  }
  .ping-dot {
    position: relative;
    display: inline-flex;
    border-radius: 9999px;
    height: 8px;
    width: 8px;
    background-color: var(--color-blue-500);
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2.5);
      opacity: 0;
    }
  }
}

  /* Date filter */
  .date-filter {
    display: flex;
    justify-content: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Metrics Panel - Grid Layout */
  .card-metrics {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }
  @media (min-width: 640px) {
    .card-metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .card-metrics {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-card {
    background: var(--card-bg);
    border-radius: 24px; /* rounded-3xl */
    padding: 24px;
    border: var(--glass);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1), background 0.5s ease;
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;

    &:nth-child(1) { animation-delay: 0.1s; }
    &:nth-child(2) { animation-delay: 0.2s; }
    &:nth-child(3) { animation-delay: 0.3s; }
    &:nth-child(4) { animation-delay: 0.4s; }

    &:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }

    & .metric-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 16px;
    }

    & .icon-wrapper {
      padding: 12px;
      border-radius: 16px; /* rounded-2xl */
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.3s ease;
    }

    &:hover .icon-wrapper {
      transform: scale(1.1) rotate(3deg);
    }

    & .trend-badge {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 0.75rem; /* text-xs */
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 9999px;

      &.positive {
        background-color: rgba(16, 185, 129, 0.08);
        color: var(--color-emerald-500);
      }

      &.negative {
        background-color: rgba(239, 68, 68, 0.08);
        color: var(--color-red-500);
      }
    }

    & .metric-content {
      display: flex;
      flex-direction: column;
    }

    & .value {
      font-size: 2rem; /* text-[2rem] */
      font-weight: 800;
      line-height: 1;
      color: var(--text);
      font-family: var(--font-sans);
      letter-spacing: -0.025em;
      margin-bottom: 4px;
    }

    & .label {
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.875rem; /* text-sm */
    }
  }

  /* Metric Color overrides */
  .metric-indigo .icon-wrapper {
    background-color: rgba(99, 102, 241, 0.08); /* bg-indigo-50 */
    color: var(--color-indigo-600);
    border: 1px solid rgba(99, 102, 241, 0.15);
  }
  .metric-emerald .icon-wrapper {
    background-color: rgba(16, 185, 129, 0.08); /* bg-emerald-50 */
    color: var(--color-emerald-500);
    border: 1px solid rgba(16, 185, 129, 0.15);
  }
  .metric-orange .icon-wrapper {
    background-color: rgba(249, 115, 22, 0.08); /* bg-orange-50 */
    color: var(--color-amber-500);
    border: 1px solid rgba(249, 115, 22, 0.15);
  }
  .metric-blue .icon-wrapper {
    background-color: rgba(59, 130, 246, 0.08); /* bg-blue-50 */
    color: var(--color-blue-500);
    border: 1px solid rgba(59, 130, 246, 0.15);
  }

  /* Generic card */
  .card {
    background: var(--card-bg);
    padding: 28px;
    border-radius: 24px; /* rounded-3xl */
    box-shadow: var(--shadow);
    border: var(--glass);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1), background 0.5s ease;
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeInUp 0.6s ease-out 0.5s forwards;

    &:hover {
      box-shadow: var(--shadow-lg);
    }
  }

  .card-header-wrapper {
    margin-bottom: 24px;
  }

  .card-title {
    font-size: 1.1rem; /* text-[1.1rem] */
    font-weight: 700;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.025em;
  }

  .card-subtitle {
    font-size: 0.875rem; /* text-sm */
    color: var(--text-secondary);
    margin: 2px 0 0 0;
    font-weight: 500;
  }

  /* Chart containers */
  .chart-container {
    height: 45vh;
    min-height: 350px;
    max-height: 550px;
    position: relative;
    width: 100%;
  }

  .chart-container-sm {
    height: 30vh;
    min-height: 250px;
    max-height: 400px;
    position: relative;
    width: 100%;
  }

  /* Tables */
  table {
    width: 100%;
    border-collapse: collapse;
  }

  th, td {
    padding: 16px;
    text-align: left;
    font-size: 0.875rem;
    color: var(--text);
  }

  thead th {
    text-transform: uppercase;
    font-weight: 800;
    font-size: 11px; /* text-[11px] */
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    border-bottom: 2px solid var(--border);
    padding-bottom: 16px;
  }

  tbody tr {
    background: transparent;
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s ease, transform 0.2s ease;

    &:hover {
      background-color: rgba(248, 250, 252, 0.9);
      transform: translateX(4px);
    }
  }

  .dark tbody tr:hover {
    background-color: rgba(255, 255, 255, 0.03);
  }

  tbody tr:hover td:first-child {
    border-left: 3px solid var(--color-blue-500);
  }

  /* Store cell */
  .store-cell {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
  }

  .store-logo-wrapper {
    width: 40px;
    height: 40px;
    border-radius: 50%; /* circular */
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border: 2px solid var(--brand-color, var(--card-bg));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
    background-color: transparent;
    flex-shrink: 0;
  }

  tbody tr:hover .store-logo-wrapper {
    transform: scale(1.15) rotate(2deg);
    border-color: var(--brand-color) !important;
    box-shadow: 0 0 20px var(--brand-color), 0 4px 12px rgba(0, 0, 0, 0.15);
  }

  .store-logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 50%;
  }

  .store-name-text {
    font-weight: 700;
    color: var(--text);
    font-size: 0.875rem;
  }

  /* Performance Badge */
  .perf-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 0.75rem;
    border-width: 1px;
    border-style: solid;
  }

  .perf-badge-high {
    background-color: rgba(16, 185, 129, 0.05); /* bg-emerald-50 */
    border-color: rgba(16, 185, 129, 0.2); /* border-emerald-200 */
    color: var(--color-emerald-500);
  }

  .perf-badge-low {
    background-color: rgba(249, 115, 22, 0.05); /* bg-orange-50 */
    border-color: rgba(249, 115, 22, 0.2); /* border-orange-200 */
    color: var(--color-amber-500);
  }

  /* Progress bar shimmer and layouts */
  .progress-cell-wrapper {
    width: 100%;
    max-width: 160px;
    display: flex;
    align-items: center;
  }

  .progress-track {
    width: 100%;
    background: var(--progress);
    border-radius: 9999px;
    height: 8px; /* h-2 */
    overflow: hidden;
    position: relative;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .progress-fill {
    height: 100%;
    border-radius: 9999px;
    position: relative;
    overflow: hidden;
    transition: width 0.5s ease;
  }

  .progress-shimmer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0) 100%);
    background-size: 200% 100%;
    animation: shimmer-anim 2s infinite linear;
  }

  @keyframes shimmer-anim {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  /* Tooltips */
  .tooltip {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: help;

    &::after {
      content: attr(data-tooltip);
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%) translateY(-5px);
      background: var(--text);
      color: var(--main-bg);
      padding: 12px 14px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 500;
      white-space: normal;
      width: max-content;
      max-width: 220px;
      opacity: 0;
      visibility: hidden;
      transition: all 0.2s ease;
      box-shadow: var(--shadow-lg);
      z-index: 101;
    }

    &::before {
      content: '';
      position: absolute;
      top: calc(100% + 1px);
      left: 50%;
      transform: translateX(-50%) translateY(-5px);
      border: 6px solid transparent;
      border-bottom-color: var(--text);
      opacity: 0;
      visibility: hidden;
      transition: all 0.2s ease;
      z-index: 101;
    }

    &:hover::after,
    &:hover::before {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }
  }

  .tooltip-icon {
    margin-left: 6px;
    font-size: 0.85em;
    color: var(--active);
    opacity: 0.8;
  }

  /* Table responsive */
  .table-responsive {
    overflow-x: auto;
    border-radius: var(--radius-md);
  }

  /* Loading state */
  .loading tbody {
    animation: pulse 1s infinite alternate;

    & td {
      color: transparent !important;
    }

    & img,
    & .store-name {
      opacity: 0;
    }
  }

  /* Utility classes */
  .text-center {
    text-align: center;
  }

  /* ==========================================================================
     SKELETON LOADING
     ========================================================================== */

  @keyframes shimmer-anim {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .skeleton {
    background: linear-gradient(90deg, var(--border) 0%, var(--card-bg) 50%, var(--border) 100%);
    background-size: 200% 100%;
    animation: shimmer-anim 1.5s infinite;
    border-radius: 8px;
  }

  .skeleton-card {
    background: var(--card-bg);
    border-radius: 24px;
    padding: 24px;
    border: var(--glass);
    margin-bottom: 16px;
  }

  .skeleton-metric-value {
    width: 60px;
    height: 2.5rem;
    border-radius: 8px;
    margin-bottom: 8px;
  }

  .skeleton-metric-label {
    width: 120px;
    height: 0.875rem;
    border-radius: 4px;
  }

  .skeleton-table-row td {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .skeleton-table-cell {
    height: 0.875rem;
    border-radius: 4px;
    margin: 4px 0;
  }

  .skeleton-table-cell:last-child {
    width: 60%;
  }

  .skeleton-metrics {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 16px;
  }
  @media (min-width: 640px) {
    .skeleton-metrics { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .skeleton-metrics { grid-template-columns: repeat(4, 1fr); }
  }
}

/* ==========================================================================
   ERROR STATE
   ========================================================================== */

@layer error-state {
  .app-error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    background: var(--card-bg);
    border-radius: var(--radius-xl);
    border: 2px solid var(--low);
    box-shadow: var(--shadow);
    text-align: center;
    margin-bottom: 32px;
    animation: fadeInDown 0.5s ease-out;

    & .error-icon {
      font-size: 3rem;
      color: var(--low);
      margin-bottom: 16px;
    }

    & h3 {
      margin: 0 0 8px;
      font-size: 1.4em;
      color: var(--text);
    }

    & p {
      margin: 0;
      color: var(--text-secondary);
      font-size: 0.95rem;
    }
  }
}

/* ==========================================================================
   UTILITIES
   ========================================================================== */

@layer utilities {
  .flex {
    display: flex;
  }

  .flex-col {
    flex-direction: column;
  }

  .items-center {
    align-items: center;
  }

  .justify-center {
    justify-content: center;
  }

  .justify-between {
    justify-content: space-between;
  }

  .grid {
    display: grid;
  }

  .gap-4 {
    gap: 16px;
  }

  .gap-8 {
    gap: 32px;
  }

  .w-full {
    width: 100%;
  }

  .h-full {
    height: 100%;
  }

  .relative {
    position: relative;
  }

  .overflow-hidden {
    overflow: hidden;
  }

  .rounded-lg {
    border-radius: var(--radius-lg);
  }

  .rounded-xl {
    border-radius: var(--radius-xl);
  }
}

/* ==========================================================================
   THEME
   ========================================================================== */

@layer theme {
  /* Print mode wrapper (aplicado via JS antes de imprimir) */
  body.is-printing {
    & .top-bar,

    & #darkModeToggle,
    & .date-filter,
    & .custom-dropdown,
    & .trend-custom-legend,
    & .tooltip-icon {
      display: none !important;
    }

    & *,
    & *::before,
    & *::after {
      animation: none !important;
      transition: none !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    & html,
    & {
      background: #ffffff !important;
      color: #1e293b !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      height: auto !important;
      min-height: auto !important;
    }

    & .dashboard-layout {
      display: block !important;
      width: 100% !important;
      height: auto !important;
      overflow: visible !important;
      max-width: 100% !important;
    }

    & .main-content {
      width: 100% !important;
      max-width: 100% !important;
      padding: 6px 10px !important;
      margin: 0 !important;
      box-sizing: border-box !important;
      overflow: visible !important;
    }

    /* Titulo compacto */
    & .header-card {
      background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
      color: #ffffff !important;
      border: none !important;
      padding: 10px 14px !important;
      margin-bottom: 8px !important;
      text-align: center !important;
      border-radius: 6px !important;
      box-shadow: none !important;
      display: block !important;
      opacity: 1 !important;

      & h1 {
        color: #ffffff !important;
        font-size: 1.1em !important;
        font-weight: 800 !important;
        line-height: 1.2 !important;
        margin: 0 !important;
      }
    }

    /* Metricas em linha horizontal compacta */
    & .card-metrics {
      display: flex !important;
      flex-direction: row !important;
      gap: 6px !important;
      margin-bottom: 8px !important;
      width: 100% !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    & .metric-card {
      flex: 1 !important;
      background: #f8fafc !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      padding: 7px 10px !important;
      border-radius: 5px !important;
      display: flex !important;
      align-items: center !important;
      gap: 7px !important;
      opacity: 1 !important;
      animation: none !important;

      & .icon {
        width: 26px !important;
        height: 26px !important;
        font-size: 12px !important;
        border-radius: 5px !important;
        background: rgba(99, 102, 241, 0.12) !important;
        color: #6366f1 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex-shrink: 0 !important;
      }

      & .value {
        font-size: 1.05em !important;
        color: #4f46e5 !important;
        -webkit-text-fill-color: #4f46e5 !important;
        background: none !important;
        font-weight: 800 !important;
        line-height: 1 !important;
      }

      & .label {
        font-size: 0.6rem !important;
        color: #64748b !important;
        line-height: 1.2 !important;
      }
    }

    & .content-grid {
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
      width: 100% !important;
    }

    & .chart-grid {
      display: flex !important;
      flex-direction: row !important;
      gap: 6px !important;
      width: 100% !important;

      & .card {
        flex: 1 !important;
        margin-bottom: 0 !important;
      }
    }

    & .card {
      background: #ffffff !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      padding: 10px 12px !important;
      margin-bottom: 8px !important;
      border-radius: 5px !important;
      opacity: 1 !important;
      animation: none !important;
      display: block !important;
      width: 100% !important;
      position: relative !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
      box-sizing: border-box !important;

      & h2 {
        font-size: 0.8em !important;
        font-weight: 700 !important;
        margin: 0 0 6px 0 !important;
        color: #1e293b !important;
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
      }
    }

    & .chart-container {
      height: 150px !important;
      display: block !important;
      position: relative !important;
      width: 100% !important;
    }

    & .chart-container-sm {
      height: 120px !important;
      display: block !important;
      position: relative !important;
      width: 100% !important;
    }

    & canvas {
      max-width: 100% !important;
      width: 100% !important;
      height: 100% !important;
    }

    /* Tabela na mesma pagina (sem quebra forcada) */
    & .detailed-data-card {
      break-before: avoid !important;
      page-break-before: avoid !important;
      margin-top: 0 !important;
    }

    & .table-responsive {
      overflow: visible !important;
      width: 100% !important;
    }

    /* Tabela compacta e legivel */
    & table {
      font-size: 0.72rem !important;
      width: 100% !important;
      table-layout: fixed !important;
      color: #1e293b !important;
      border-spacing: 0 3px !important;
      border-collapse: separate !important;
    }

    & th,
    & td {
      padding: 6px 7px !important;
      word-wrap: break-word !important;
      overflow-wrap: break-word !important;
      white-space: normal !important;
    }

    & td:first-child {
      display: flex !important;
      align-items: center !important;
      gap: 6px !important;
    }

    & thead th {
      font-size: 0.63rem !important;
      font-weight: 700 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.04em !important;
      padding-bottom: 5px !important;
      border-bottom: 2px solid #e2e8f0 !important;
      color: #64748b !important;
      background: transparent !important;
    }

    & thead th:nth-child(1), & tbody td:nth-child(1) { width: 20% !important; }
    & thead th:nth-child(2), & tbody td:nth-child(2) { width: 13% !important; }
    & thead th:nth-child(3), & tbody td:nth-child(3) { width: 13% !important; }
    & thead th:nth-child(4), & tbody td:nth-child(4) { width: 10% !important; }
    & thead th:nth-child(5), & tbody td:nth-child(5) { width: 12% !important; }
    & thead th:nth-child(6), & tbody td:nth-child(6) { width: 13% !important; }
    & thead th:nth-child(7), & tbody td:nth-child(7) { width: 19% !important; }

    & tbody tr {
      background: #ffffff !important;
      box-shadow: none !important;
      border-bottom: 1px solid #f1f5f9 !important;
    }

    & tbody tr:nth-child(even) {
      background: #f8fafc !important;
    }

    & .store-logo {
      width: 20px !important;
      height: 20px !important;
      border-radius: 4px !important;
      background: #ffffff !important;
      flex-shrink: 0 !important;
    }

    & .store-name {
      font-weight: 700 !important;
      font-size: 0.72rem !important;
      color: #1e293b !important;
    }

    & .progress-cell {
      width: 19% !important;
    }

    & .progress-container {
      height: 7px !important;
      background: #e2e8f0 !important;
      border-radius: 99px !important;
      width: 100% !important;
    }

    & .progress-bar {
      height: 100% !important;
      border-radius: 99px !important;
    }

    & .percent-value {
      font-weight: 700 !important;
      font-size: 0.72rem !important;
    }

    & .tooltip {
      display: inline !important;

      &::after,
      &::before,
      & .tooltip-icon {
        display: none !important;
      }
    }
  }
}

/* ==========================================================================
   PRINT
   ========================================================================== */

@media print {
  @page {
    size: A4 portrait;
    margin: 10mm 8mm;
  }

  /* Ocultar tudo exceto o conteúdo do overlay */
  body > *:not(.print-overlay) {
    display: none !important;
  }

  /* Garantir que o overlay seja exibido */
  .print-overlay {
    display: block !important;
    position: static !important;
    width: 100% !important;
    min-height: auto !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .a4-paper {
    width: 100% !important;
    min-height: auto !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
  }

  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
}
  display: flex;
  justify-content: center;
  gap: 16px;
  margin-top: 16px;
  flex-wrap: wrap;
  width: 100%;
}

.trend-legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  background: var(--card-bg);
  border: 1px solid var(--border);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
  transition: all 0.2s ease;
  box-shadow: var(--shadow);
  user-select: none;
}

.trend-legend-item:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-lg);
  color: var(--text);
  background: var(--card-bg);
}

.trend-legend-item.hidden-dataset {
  opacity: 0.4;
  text-decoration: line-through;
  background: rgba(0, 0, 0, 0.05);
}

.dark .trend-legend-item.hidden-dataset {
  background: rgba(255, 255, 255, 0.05);
}

.trend-legend-img {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  object-fit: cover;
  border: 1px solid var(--border);
  background: transparent;
}

.trend-legend-color {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
}

/* Modern Custom Period Selector Dropdown */
.custom-dropdown {
  position: relative;
  width: 280px;
  margin: 0 auto;
  font-family: var(--font-sans);
}

.dropdown-trigger {
  width: 100%;
  background: var(--card-bg);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border);
  padding: 12px 20px;
  border-radius: var(--radius-md);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: var(--shadow);
  color: var(--text);
  font-weight: 600;
  font-size: 0.95rem;
  text-align: left;
}

.dropdown-trigger:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-lg);
  border-color: var(--active);
}

.trigger-content {
  display: flex;
  flex-direction: column;
}

.trigger-label {
  font-size: 0.7rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  display: block;
  font-weight: 600;
  margin-bottom: 2px;
}

.trigger-value {
  font-size: 1rem;
  font-weight: 700;
  display: block;
  color: var(--text);
}

.chevron-icon {
  font-size: 0.9rem;
  color: var(--text-secondary);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.custom-dropdown.open .chevron-icon {
  transform: rotate(180deg);
  color: var(--active);
}

.custom-dropdown.open .dropdown-trigger {
  border-color: var(--active);
}

.dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  width: 100%;
  background: var(--card-bg);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  z-index: 100;
  max-height: 300px;
  overflow-y: auto;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.custom-dropdown.open .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dropdown-menu::-webkit-scrollbar {
  width: 6px;
}
.dropdown-menu::-webkit-scrollbar-track {
  background: transparent;
}
.dropdown-menu::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 3px;
}
.dropdown-menu::-webkit-scrollbar-thumb:hover {
  background: var(--text-secondary);
}

.dropdown-group {
  border-bottom: 1px solid var(--border);
}

.dropdown-group:last-child {
  border-bottom: none;
}

.group-title {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--active);
  background: rgba(99, 102, 241, 0.05);
  padding: 8px 16px;
  letter-spacing: 0.05em;
  position: sticky;
  top: 0;
  backdrop-filter: blur(8px);
  z-index: 10;
}

.group-items {
  padding: 4px;
}

.dropdown-item {
  padding: 10px 16px;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dropdown-item:hover {
  background: rgba(99, 102, 241, 0.08);
  color: var(--text);
  padding-left: 20px;
}

.dropdown-item.active {
  background: var(--gradient);
  color: #ffffff;
  font-weight: 700;
}

.dropdown-item.active:hover {
  background: var(--gradient);
  color: #ffffff;
  padding-left: 16px;
}

/* ==========================================================================
   PRINT TABLES
   ========================================================================== */

/* Oculta as tabelas de impressão no modo normal */
.print-table-wrapper {
  display: none;
}

/* Mostra tabelas e oculta canvas no modo is-printing (JS) */
body.is-printing .print-table-wrapper {
  display: block !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
}

body.is-printing .chart-container canvas,
body.is-printing .chart-container-sm canvas {
  display: none !important;
}

/* Mostra tabelas e oculta canvas no @media print */
@media print {
  .chart-container canvas,
  .chart-container-sm canvas {
    display: none !important;
  }

  .print-table-wrapper {
    display: block !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }
}

/* Estilos da tabela de dados de impressão */
.print-data-table {
  width: 100% !important;
  border-collapse: collapse !important;
  font-size: 0.72rem !important;
  font-family: 'Inter', system-ui, sans-serif !important;
  color: #1e293b !important;
  table-layout: auto !important;
}

.print-data-table thead tr {
  background: #f1f5f9 !important;
}

.print-data-table thead th {
  padding: 5px 8px !important;
  text-align: left !important;
  font-size: 0.62rem !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.05em !important;
  color: #64748b !important;
  border-bottom: 2px solid #e2e8f0 !important;
  white-space: nowrap !important;
}

.print-data-table tbody tr {
  border-bottom: 1px solid #f1f5f9 !important;
  background: #ffffff !important;
}

.print-data-table tbody tr:nth-child(even) {
  background: #f8fafc !important;
}

.print-data-table tbody td {
  padding: 5px 8px !important;
  font-size: 0.72rem !important;
  color: #1e293b !important;
  vertical-align: middle !important;
}

.print-data-table .store-col {
  white-space: nowrap !important;
  font-weight: 700 !important;
}
/* ==========================================================================
   IMPRESSÃO EXECUTIVA - DESIGN SYSTEM
   ========================================================================== */

.print-overlay { display: none; }

.is-printing {
  overflow: hidden !important;
  height: 100% !important;

  /* Oculta TUDO no body exceto o print-overlay */
  & > *:not(.print-overlay) {
    display: none !important;
  }

  & .print-overlay {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 100vh;
    padding: 0;
    margin: 0;
    background-color: #52525b;
    z-index: 10000;
    font-family: 'Inter', sans-serif;
    overflow: auto;
  }

  & .a4-paper {
    width: 210mm;
    min-height: 297mm;
    background-color: white;
    padding: 15mm;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    box-sizing: border-box;
    position: relative;
    color: #1f2937;
  }

  /* Utility classes mapped from the provided Tailwind layout */
  .print-header-a4 {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 2px solid #1f2937;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;

    .title {
      font-size: 1.5rem;
      font-weight: 700;
      color: black;
      letter-spacing: -0.025em;
      text-transform: uppercase;
      margin: 0;
    }

    .subtitle {
      font-size: 0.875rem;
      color: #4b5563;
      margin-top: 0.25rem;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 0;
    }

    .meta {
      text-align: right;
      font-size: 0.75rem;
      color: #6b7280;

      p { margin: 0; }
    }
  }

  .kpis-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .kpi-card {
    border: 1px solid #e5e7eb;
    background-color: #f9fafb;
    padding: 0.75rem;
    border-radius: 0.25rem;

    .kpi-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.25rem;
      margin-top: 0;
    }

    .kpi-val {
      font-size: 1.5rem;
      font-weight: 900;
      color: black;
      margin: 0;
    }
  }

  .charts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .chart-box {
    border: 1px solid #e5e7eb;
    padding: 0.75rem;
    border-radius: 0.25rem;
  }

  .chart-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: #1f2937;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    margin-top: 0;
  }

  .chart-canvas {
    position: relative;
    height: 12rem;
    width: 100%;
    
    canvas {
      width: 100% !important;
      height: 100% !important;
    }
  }

  .table-section {
    width: 100%;
  }

  .a4-data-table {
    width: 100%;
    font-size: 0.875rem;
    border-collapse: collapse;
    border: 1px solid #d1d5db;

    thead {
      background-color: #f3f4f6;
    }

    th {
      border: 1px solid #d1d5db;
      padding: 0.5rem;
      font-weight: 700;
      color: #374151;
      text-transform: uppercase;
    }

    td {
      border: 1px solid #d1d5db;
      padding: 0.5rem;
    }
  }

  .print-footer-a4 {
    position: absolute;
    bottom: 1rem;
    left: 0;
    width: 100%;
    text-align: center;
    font-size: 10px;
    color: #6b7280;
  }

  /* Utility classes for inline dynamic usage */
  .text-left { text-align: left; }
  .text-center { text-align: center; }
  .w-1-5 { width: 20%; }
  .w-full { width: 100%; }
  .bg-gray-50 { background-color: #f9fafb; }
  .bg-gray-200 { background-color: #e5e7eb; }
  .h-2 { height: 0.5rem; }
  .font-bold { font-weight: 700; }
  .text-black { color: black; }
  .text-blue-600 { color: #2563eb; }
  .text-green-600 { color: #16a34a; }
  .text-orange-500 { color: #f97316; }
  .text-red-600 { color: #dc2626; }
  .text-gray-600 { color: #4b5563; }
  .text-gray-800 { color: #1f2937; }
  .border-px-2 { padding-left: 0.5rem; padding-right: 0.5rem; }
  .text-10px { font-size: 10px; }
  .text-11px { font-size: 11px; }
  .text-9px { font-size: 9px; }
}

